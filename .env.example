POSTGRES_USER=qwerty
POSTGRES_PASSWORD=qwerty_secret
POSTGRES_DB=qwerty
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# LLM (OpenAI) — put the real key only into .env (gitignored)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cross-encoder reranker: needs ~2.5 GB extra RAM, off on 8 GB machines
RERANKER_ENABLED=false
# OCR on Windows/Linux (Mac uses Apple Vision). Only if tesseract is not on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
