POSTGRES_USER=qwerty
POSTGRES_PASSWORD=qwerty_secret
POSTGRES_DB=qwerty
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# LLM (OpenAI) — put the real key only into .env (gitignored)
OPENAI_API_KEY=
# Answer model. gpt-4o is the team's standard. Mind its organisation limit: 30k tokens/min ≈ 7 questions per minute
# in total. gpt-6-luna answered about as well on the eval, ~20x cheaper, 200k tokens/min (REPORT.md, "Задача 10")
OPENAI_MODEL=gpt-4o
# mode=deep (empty = OPENAI_MODEL)
OPENAI_MODEL_DEEP=
# The short call that turns a Russian question or a follow-up into a Romanian search query
OPENAI_REWRITE_MODEL=gpt-6-luna
# Other providers (optional; keys and models can also be set in admin → Models, which wins over these)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible server of your own (Ollama: http://localhost:11434/v1, vLLM, LM Studio...), key optional
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
# Reasoning models only: "none" gives the first word ~0.4 s sooner, "low" answered better on eval/freshness.yaml
OPENAI_REASONING_EFFORT=low
# OCR on Windows/Linux (Mac uses Apple Vision). Only if tesseract is not on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Backend: allowed origins (comma-separated). CORS_ORIGINS=* for the widget embedded on other sites
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Backend: questions per minute per client on /api/ask and /api/ask/stream
ASK_RATE_LIMIT=10
# Where crawl output, downloaded files (raw/: PDFs for the viewer), logs and dumps live.
# Empty = <repo>/data (Docker: /app/data, the oidata volume)
SPOTT_DATA_DIR=
# Backend: admin panel login (POST /api/admin/login → 12 h session token). Empty = admin off (401)
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Optional: key that signs admin sessions (default: derived from login+password; a new password ends all sessions)
ADMIN_SECRET=
ADMIN_SESSION_HOURS=12
# Backend: quick questions are re-asked (LLM calls) after the index changes and daily; checked every N seconds
SUGGESTIONS_RECHECK=true
SUGGESTIONS_EVERY_S=600
# Docker (./start.sh): the API's port on this machine; DOMAIN only for ./start.sh --https (a server with a domain)
API_PORT=8000
DOMAIN=
